# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Every variable is optional unless noted; defaults live in src/aml_sentinel/config.py.

ENVIRONMENT=dev                 # dev | test | prod
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true                   # structured JSON logs

DATA_DIR=data
MODELS_DIR=models
RANDOM_SEED=42

# Time-based split cut-offs (half-open intervals, see docs/DECISIONS.md ADR-003).
TRAIN_END=2022-09-07T00:00:00
VAL_END=2022-09-09T00:00:00
TEST_END=2022-09-11T00:00:00

# SAR drafting backend. "template" is fully local and needs no key.
LLM_PROVIDER=template           # template | external
LLM_API_KEY=                    # REQUIRED when LLM_PROVIDER=external (Anthropic key)
LLM_MODEL=claude-opus-5-5       # external SAR drafter model; only pseudonymised facts are sent

# Jev benchmark adapter (closed hosted API). Synthetic data ONLY. Off by default.
JEV_ENABLED=false
JEV_API_KEY=                    # REQUIRED when JEV_ENABLED=true

# API and dashboard (Phase 7). Create keys with `make api-key KEY_USER=alice KEY_ROLE=analyst`;
# only the SHA-256 digests go here, comma-separated as user:role:digest.
API_KEYS=                       # REQUIRED to start the API
API_DATASET=Sample              # Sample | HI-Small | LI-Small
API_CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
API_ALLOWED_HOSTS=["localhost","127.0.0.1"]
API_RATE_LIMIT_PER_MINUTE=120
API_MAX_REQUEST_BYTES=65536
API_SCORE_MAX_HISTORY_ROWS=100000   # POST /score is refused above this history size
DASHBOARD_API_URL=http://127.0.0.1:8000
