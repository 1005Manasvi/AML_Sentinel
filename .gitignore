# --- Data and model artifacts: never committed (see data/README.md) ---
data/raw/*
!data/raw/.gitkeep
/data/processed/
/data/interim/
# Audit log stays local: it records who did what (append-only, hash-chained).
/data/audit/
# Analyst case notes and SAR versions (API case store); may quote dataset rows.
/data/cases/
# Root-anchored: an unanchored "models/" would also hide src/aml_sentinel/models.
/models/
/artifacts/
/reports/generated/
# SAR drafts quote raw dataset rows; generate locally with `make rank sar`.
/reports/sar/
*.parquet
*.csv
# The small, self-generated synthetic sample IS committed (demo without Kaggle).
!data/sample/*.csv
*.pkl
*.pickle
*.joblib
*.safetensors
*.pt
*.bin

# --- Secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# --- Tooling caches ---
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ipynb_checkpoints/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# Downloaded CI log archives
logs_*/
logs_*.zip
